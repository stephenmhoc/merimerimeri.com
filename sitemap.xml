---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/apps/' | absolute_url }}</loc></url>
  {% for p in site.projects %}<url><loc>{{ p.url | absolute_url }}</loc></url>
  {% endfor %}
  {%- if site.blog.size > 0 %}
  <url><loc>{{ '/blog/' | absolute_url }}</loc></url>
  {% for p in site.blog %}<url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</lastmod></url>
  {% endfor %}
  {%- endif %}
</urlset>
