#!/usr/bin/env ruby

require "digest"
require "fileutils"

site_dir = File.expand_path(ARGV.fetch(0, "_site"))
css_path = File.join(site_dir, "css", "site.css")

abort "Missing built stylesheet: #{css_path}" unless File.file?(css_path)

digest = Digest::SHA256.file(css_path).hexdigest[0, 12]
fingerprinted_name = "site-#{digest}.css"
fingerprinted_path = File.join(site_dir, "css", fingerprinted_name)

FileUtils.cp(css_path, fingerprinted_path)

stylesheet_pattern = %r{/css/site\.css(?:\?v=[^\"']+)?}
stylesheet_url = "/css/#{fingerprinted_name}"
updated_pages = 0

Dir.glob(File.join(site_dir, "**", "*.html")).each do |html_path|
  html = File.binread(html_path)
  updated_html = html.gsub(stylesheet_pattern, stylesheet_url)
  next if updated_html == html

  File.binwrite(html_path, updated_html)
  updated_pages += 1
end

puts "Fingerprinted #{css_path} as #{fingerprinted_name} in #{updated_pages} pages"
